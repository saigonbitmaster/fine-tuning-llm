# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#1188, it is a recommended practice to gitignore and not commit Pipfile.lock in development applications, but NOT in standalone applications.
#Pipfile.lock

# poetry
#   Using Poetry, it is generally recommended to include poetry.lock in your repository.
#   But if you really want to ignore it:
#poetry.lock

# pdm
#   Similar to Pipfile.lock / poetry.lock, those should be committed in applications
#   but gitignored in libraries
#pdm.lock
.pdm-plugins/

# PEP 582 project packages
__pypackages__/

